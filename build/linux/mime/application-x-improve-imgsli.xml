<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <!-- LEGACY: pre-rename Improve-ImgSLI project packages (*.imgsli).

       The container format did not change — only its name — so the current
       type application/vnd.blinktable.project+zip owns the content magic
       (PK + project.json at offset 30) and normally wins for these files as
       well. This entry exists so an *.imgsli path still resolves to a project
       type (e.g. an empty/corrupt package without the magic) and so old
       per-user "open with" choices keep working. Never remove without a
       deprecation release that stops opening *.imgsli.
  -->
  <mime-type type="application/x-improve-imgsli">
    <comment>BlinkTable project (legacy .imgsli)</comment>
    <comment xml:lang="ru">Проект BlinkTable (устаревший .imgsli)</comment>
    <comment xml:lang="pt_BR">Projeto BlinkTable (.imgsli legado)</comment>
    <comment xml:lang="zh">BlinkTable 项目（旧版 .imgsli）</comment>
    <acronym>ImgSLI</acronym>
    <icon name="application-vnd.blinktable.project+zip"/>
    <generic-icon name="x-office-document"/>
    <glob weight="60" pattern="*.imgsli"/>
    <glob weight="60" pattern="*.IMGSLI"/>
  </mime-type>
</mime-info>
